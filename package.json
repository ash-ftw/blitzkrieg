{
  "name": "blitzkrieg",
  "version": "0.1.0",
  "private": true,
  "description": "LAN-first competitive typing event platform for high-stakes college lab tournaments.",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/ash-ftw/blitzkrieg.git"
  },
  "bugs": {
    "url": "https://github.com/ash-ftw/blitzkrieg/issues"
  },
  "homepage": "https://github.com/ash-ftw/blitzkrieg#readme",
  "keywords": [
    "competitive-typing",
    "typing-competition",
    "lan-first",
    "college-tournament",
    "fastify",
    "socket-io",
    "react",
    "anti-cheat",
    "proctoring"
  ],
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "scripts": {
    "start": "node scripts/dev.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:all": "node scripts/dev.mjs",
    "dev:frontend": "npm run dev --workspace @blitzkrieg/frontend",
    "dev:backend": "npm run dev --workspace @blitzkrieg/backend",
    "build": "npm run build --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "lint": "npm run lint --workspaces --if-present"
  },
  "devDependencies": {
    "typescript-eslint": "^8.42.0"
  },
  "engines": {
    "node": ">=22"
  },
  "type": "module"
}
